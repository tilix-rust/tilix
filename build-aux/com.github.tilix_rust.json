{
  "app-id": "com.github.tilix_rust",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "tilix",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--filesystem=host",
    "--device=all",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/tilix/cargo"
    }
  },
  "modules": [
    {
      "name": "tilix",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --verbose",
        "install -Dm755 target/release/tilix /app/bin/tilix",
        "install -Dm644 data/com.github.tilix_rust.desktop /app/share/applications/com.github.tilix_rust.desktop",
        "install -Dm644 data/com.github.tilix_rust.metainfo.xml /app/share/metainfo/com.github.tilix_rust.metainfo.xml",
        "install -Dm644 data/icons/scalable/apps/com.github.tilix_rust.svg /app/share/icons/hicolor/scalable/apps/com.github.tilix_rust.svg",
        "install -Dm644 data/completions/bash/tilix /app/share/bash-completion/completions/tilix",
        "install -Dm644 data/completions/zsh/_tilix /app/share/zsh/site-functions/_tilix",
        "install -Dm644 data/completions/fish/tilix.fish /app/share/fish/vendor_completions.d/tilix.fish"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../"
        }
      ]
    }
  ]
}
